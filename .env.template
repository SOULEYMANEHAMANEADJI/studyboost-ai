# ============================================================
# StudyBoost AI — Variables d'environnement
# ============================================================
# Copie ce fichier en .env et remplis les valeurs
# ou utilise ces clés dans Streamlit Cloud Secrets
# ============================================================

# --- Supabase (obligatoire) ---
# URL de ton projet Supabase : Settings → API → Project URL
SUPABASE_URL="https://ton_projet.supabase.co"

# Clé anon (publique) : Settings → API → anon public key
SUPABASE_ANON_KEY="ta_clé_anon_supabase_ici"

# Optionnel — nécessaire seulement pour les opérations admin via API
SUPABASE_SERVICE_KEY="ta_clé_service_role_ici"

# --- Groq (obligatoire) ---
# https://console.groq.com/keys
GROQ_API_KEY="ta_clé_groq_ici"

# --- Administration (obligatoire) ---
# Mot de passe pour accéder au dashboard admin (URL /admin_secret_access)
ADMIN_PASSWORD="ton_mot_de_passe_admin_ici"

# --- Google (optionnel — réservé) ---
GOOGLE_API_KEY="ta_clé_google_ici"
