# --- Base de données Neon (obligatoire) ---
# Connection string obtenue sur https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# --- Groq (obligatoire) ---
# https://console.groq.com/keys
GROQ_API_KEY="ta_clé_groq_ici"

# --- Administration (obligatoire) ---
# Mot de passe pour accéder au dashboard admin (URL /admin_secret_access)
ADMIN_PASSWORD="ton_mot_de_passe_admin_ici"
